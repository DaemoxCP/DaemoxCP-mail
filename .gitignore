# Build output: "mvn package" makes it again, it does not belong in git.
# Before this file the repository tracked 289 of these files, 32 MB of jars among them: every
# diff carried them along, and three times in one session they blocked a
# "git checkout" and a "git rebase" because they showed as modified.
target/

# macOS noise, one per folder the Finder opened.
.DS_Store

# Tests compiled in place (javac -d tests): they are made again, and one ended up in a commit by mistake.
tests/**/*.class
