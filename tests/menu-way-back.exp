#!/usr/bin/expect -f
# Item 6 of the panel's on-screen menu, inside a real terminal (ssh -tt) on the test clone: the
# notice at opening (an interrupted reinstallation), item 6, the confirmation (Cancel is the
# default: Tab then Enter for OK), the way back, "no" to the restart, Enter, and leaving the menu.
# Usage, from the Mac: expect tests/menu-way-back.exp <ssh key> <host> <panel folder on the clone> <jar>
set timeout 90
set key [lindex $argv 0]
set host [lindex $argv 1]
set dir [lindex $argv 2]
set jar [lindex $argv 3]
log_user 0
spawn ssh -tt -i $key -o BatchMode=yes root@$host "cd $dir && TERM=xterm exec java -jar $jar --lang en"
proc step {what pattern} {
    expect {
        -re $pattern { puts "  OK   $what" }
        timeout { puts "  FAILED $what (did not arrive: $pattern)"; exit 1 }
        eof { puts "  FAILED $what (the menu exited)"; exit 1 }
    }
}
step "the menu opens with the welcome" "Welcome to DaemoxCP Mail"
send "\r"
step "the notice: the last reinstallation did not finish, choose 6 or 4" "did not finish"
send "\r"
step "no \"Created ... script\" window to close: the menu items at once" "Select an option"
step "item 6 is there" "6\\) Go back to the server before"
send "\033\[B\033\[B\033\[B\033\[B\033\[B"
send "\r"
# Lanterna redraws only the cells that change: a sentence above the menu arrives in pieces if some
# letters match those below ("Go b" + "ck"). This one, with ssh -tt's 80x24 screen, arrives whole.
step "the confirmation" "arrived after it is kept"
send "\t"
send "\r"
step "the way back starts" "\\\[WAY BACK\\\] reinstall-before-"
step "and activates the way back for the next start" "is the system of the next start"
step "it asks whether to restart" "Restart the server now"
send "no\r"
step "it does not restart, and says how to do it later" "Not restarted"
step "it waits for Enter" "Press ENTER"
send "\r"
step "back to the menu" "Select an option"
send "\t"
send "\r"
expect eof
puts "  OK   left the menu"
exit 0
