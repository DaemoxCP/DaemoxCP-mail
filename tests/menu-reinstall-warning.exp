#!/usr/bin/expect -f
# The confirmation of menu item 4 says what gets deleted (finding 177): the mail, the domains, the
# mailboxes, the aliases and the panel's accounts with passkeys and sessions. Then Cancel
# (preselected) and leaving the menu: the reinstallation must not start. On a test clone, from a
# copy of the panel.
# Usage, from the Mac: expect tests/menu-reinstall-warning.exp <ssh key> <host> <panel folder on the clone> <jar>
set timeout 90
set key [lindex $argv 0]; set host [lindex $argv 1]; set dir [lindex $argv 2]; set jar [lindex $argv 3]
log_user 0
spawn ssh -tt -i $key -o BatchMode=yes root@$host "cd $dir && TERM=xterm exec java -jar $jar --lang en"
proc step {what pattern} {
    expect {
        -re $pattern { puts "  OK   $what" }
        timeout { puts "  FAILED $what (did not arrive: $pattern)"; exit 1 }
        eof { puts "  FAILED $what (the menu exited)"; exit 1 }
    }
}
step "the menu opens with the welcome" "Welcome to DaemoxCP Mail"
send "\r"
step "the menu items" "Select an option"
step "item 4 is there" "4\\) Install/Reinstall Mail Server"
send "\033\[B\033\[B\033\[B"
send "\r"
# The window title can arrive in pieces (Lanterna redraws only the changed cells, and a shorter
# window ends up on other lines): the new text is told apart from the old one.
expect {
    -re "DELETED" { puts "  OK   the confirmation says that mail, mailboxes and panel accounts are deleted" }
    -re "RESET!" { puts "  FAILED the confirmation only says that the configuration is reset"; exit 1 }
    timeout { puts "  FAILED no confirmation"; exit 1 }
    eof { puts "  FAILED the menu exited"; exit 1 }
}
send "\r"
# Cancel is preselected. The menu title is not redrawn (it did not change): going back to the menu
# is shown by leaving it, and the reinstallation not starting (it would ask for the server name).
after 1500
send "\t"
send "\r"
expect {
    -re "Mail Server Hostname" { puts "  FAILED cancelled: the reinstallation started instead"; exit 1 }
    eof { puts "  OK   cancelled: the menu again, and Tab+Enter leaves it" }
    timeout { puts "  FAILED the menu did not exit"; exit 1 }
}
exit 0
