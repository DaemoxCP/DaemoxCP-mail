<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.daemoxcp.mail</groupId>
    <artifactId>daemoxcp-mail</artifactId>
    <version>1.0.1</version>

    <name>FreeBSD Mail Panel</name>
    <description>Native mail server control panel for FreeBSD 15+</description>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- The build number and the commit the jar is built from, read in the dashboard
             (src/main/build-info, finding 183). Maven alone cannot read git: tools/build-jar.sh
             passes them. When empty, the panel says they were not recorded. -->
        <panel.build></panel.build>
        <panel.commit></panel.commit>
        <panel.modified></panel.modified>
        <!-- maven.build.timestamp is already in UTC: here only the form, ISO 8601 (r13). -->
        <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ss'Z'</maven.build.timestamp.format>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.1.0</version>
        </dependency>
        <dependency>
            <groupId>com.googlecode.lanterna</groupId>
            <artifactId>lanterna</artifactId>
            <version>3.1.2</version>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.47.1.0</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>2.0.16</version>
        </dependency>
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20241224</version>
        </dependency>
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>
        <!-- WebAuthn/Passkey support -->
        <dependency>
            <groupId>com.yubico</groupId>
            <artifactId>webauthn-server-core</artifactId>
            <version>2.5.0</version>
        </dependency>
        <dependency>
            <groupId>com.yubico</groupId>
            <artifactId>yubico-util</artifactId>
            <version>2.5.0</version>
        </dependency>
    </dependencies>

    <build>
        <!-- The jar is always called daemoxcp-mail.jar, without the version: the console commands, the start script
             and the README stay the same from one version to the next. The version is inside the jar (build-info). -->
        <finalName>daemoxcp-mail</finalName>
        <!-- Resources are copied as they are; only build-info.properties goes through the Maven
             filter, which writes version, build, commit and date into it. Filtering all resources
             would touch the ${...} in the page scripts and the bytes of the fonts. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>src/main/build-info</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>25</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- The Public Suffix List that httpclient5 carries along does not go into the jar. The
                                 panel builds no httpclient5 HTTP clients: the library's only use is the host name check
                                 in the Android SafetyNet attestations of webauthn-server-core, which creates
                                 DefaultHostnameVerifier() without a list (PublicSuffixMatcher null) and never reads it.
                                 The file is loaded only by CookieSpecSupport and HttpsSupport, that is, the HTTP
                                 clients. -->
                            <filters>
                                <filter>
                                    <artifact>org.apache.httpcomponents.client5:httpclient5</artifact>
                                    <excludes>
                                        <exclude>org/publicsuffix/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.daemoxcp.mail.Main</mainClass>
                                    <manifestEntries>
                                        <!-- Java 22+: we declare explicitly that the jar loads native code
                                             (libsqlite-jdbc.so via System.load). Without this, from Java 22 you see a
                                             WARNING, and from a future release the loading will be BLOCKED. -->
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/services/java.sql.Driver</resource>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
